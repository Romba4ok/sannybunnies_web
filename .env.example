# Путь к файлу сервисного аккаунта Firebase
FIREBASE_CREDENTIALS=serviceAccountKey.json

# API ключ Firebase для REST-аутентификации
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# Секретный ключ Flask для сессий
SECRET_KEY=replace-this-secret

# Роль администратора в коллекции users
ADMIN_ROLE=admin
